{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "SEO long-form blog article produced by the Nomadomics content engine"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 70
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "maxLength": 160
    },
    "bodyMarkdown": {
      "type": "text",
      "required": true
    },
    "targetKeywords": {
      "type": "json"
    },
    "metaTitle": {
      "type": "string",
      "maxLength": 60
    },
    "metaDescription": {
      "type": "string",
      "maxLength": 160
    },
    "focusKeyword": {
      "type": "string"
    },
    "seoScore": {
      "type": "integer"
    },
    "readabilityScore": {
      "type": "decimal"
    },
    "confidence": {
      "type": "integer"
    },
    "status": {
      "type": "enumeration",
      "enum": ["draft", "in_review", "published", "rejected"],
      "default": "draft"
    },
    "scheduledFor": {
      "type": "datetime"
    },
    "wpSourceUrl": {
      "type": "string"
    },
    "lastError": {
      "type": "text"
    },
    "publishedAt": {
      "type": "datetime"
    }
  }
}
