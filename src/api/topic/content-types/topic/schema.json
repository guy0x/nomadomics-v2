{
  "kind": "collectionType",
  "collectionName": "topics",
  "info": {
    "singularName": "topic",
    "pluralName": "topics",
    "displayName": "Topic",
    "description": "Content topic queue / seed for the Nomadomics engine"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "primaryKeyword": {
      "type": "string"
    },
    "targetKeywords": {
      "type": "string"
    },
    "category": {
      "type": "enumeration",
      "enum": ["budgeting", "money-saving", "backpacking", "digital-nomad", "taxes", "banking", "visas", "geoarbitrage", "gear"]
    },
    "targetWordCount": {
      "type": "integer",
      "default": 1800
    },
    "priority": {
      "type": "integer",
      "default": 5
    },
    "status": {
      "type": "enumeration",
      "enum": ["pending", "researching", "drafting", "in_review", "published", "failed"],
      "default": "pending"
    },
    "researchAngle": {
      "type": "text"
    },
    "researchFacts": {
      "type": "text"
    },
    "lastError": {
      "type": "text"
    }
  }
}
