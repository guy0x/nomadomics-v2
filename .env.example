# Strapi environment (LOCAL DEVELOPMENT ONLY)
# Copy to .env and customise. For production, generate fresh keys:
#   openssl rand -base64 32

HOST=0.0.0.0
PORT=1337
APP_KEYS=key1_devonly,key2_devonly,key3_devonly,key4_devonly
API_TOKEN_SALT=your_salt_here
ADMIN_JWT_SECRET=your_admin_jwt_here
TRANSFER_TOKEN_SALT=your_transfer_salt_here
JWT_SECRET=your_jwt_secret_here

# Database connection (Postgres — local bare-metal or Docker)
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=nomadomics
DATABASE_USERNAME=nomadomics
DATABASE_PASSWORD=nomadomics_dev_password
DATABASE_SSL=false

# MCP server (Hermes integration)
MCP_SERVER=true
